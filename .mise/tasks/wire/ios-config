#!/usr/bin/env bash
#MISE description="Write iOS local voting config that uses local vote-sdk and remote PIR"
#MISE quiet=true
set -euo pipefail

DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
CONFIG_DIR="${SVOTE_CONFIG_DIR:-$DIR/.wiring/generated/voting-config}"
STATIC_SOURCE="$DIR/token-holder-voting-config/static-voting-config.json"
ANDROID_DYNAMIC="$CONFIG_DIR/dynamic-voting-config.json"
IOS_STATIC="$CONFIG_DIR/ios-static-voting-config.json"
IOS_DYNAMIC="$CONFIG_DIR/ios-dynamic-voting-config.json"
CONFIG_PORT="${SVOTE_CONFIG_PORT:-8443}"
CHAIN_PORT="${SVOTE_CHAIN_PORT:-1317}"

ios_host() {
    case "${SVOTE_IOS_HOST:-localhost}" in
        localhost|"")
            printf '%s\n' "localhost"
            ;;
        lan)
            local iface host
            iface="$(route -n get default 2>/dev/null | sed -n 's/^ *interface: //p' | head -1)"
            host="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
            if [ -z "$host" ]; then
                host="$(ifconfig "$iface" 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" { print $2; exit }')"
            fi
            [ -n "$host" ] || host="127.0.0.1"
            printf '%s\n' "$host"
            ;;
        *)
            printf '%s\n' "$SVOTE_IOS_HOST"
            ;;
    esac
}

sslip_label() {
    printf '%s\n' "$1" | tr '.' '-'
}

service_hostname() {
    local service="$1"
    local host="$2"

    if [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf '%s.%s.sslip.io\n' "$service" "$(sslip_label "$host")"
    else
        printf '%s.%s\n' "$service" "$host"
    fi
}

[ -f "$STATIC_SOURCE" ] || { printf '\033[31mMissing %s\033[0m\n' "$STATIC_SOURCE"; exit 1; }
command -v jq >/dev/null 2>&1 || { printf '\033[31mjq is required\033[0m\n'; exit 1; }

# Reuse Android's generated dynamic file when available so local round signatures
# are produced once by wire:android-config. If this task is run standalone, build
# that base file first without touching an installed Android app.
if [ ! -f "$ANDROID_DYNAMIC" ]; then
    SVOTE_ANDROID_SKIP_ADB=1 mise run wire:android-config local
fi

mkdir -p "$CONFIG_DIR"

HOST="$(ios_host)"
CONFIG_HOST="$(service_hostname config "$HOST")"
CONFIG_BASE_URL="${SVOTE_IOS_CONFIG_BASE_URL:-https://$CONFIG_HOST:$CONFIG_PORT}"
STATIC_URL="${SVOTE_IOS_STATIC_CONFIG_URL:-$CONFIG_BASE_URL/ios-static-voting-config.json}"
DYNAMIC_URL="${SVOTE_IOS_DYNAMIC_CONFIG_URL:-$CONFIG_BASE_URL/ios-dynamic-voting-config.json}"
VOTE_URL="${SVOTE_IOS_VOTE_URL:-http://$HOST:$CHAIN_PORT}"

jq --arg dynamic "$DYNAMIC_URL" \
    '.dynamic_config_url = $dynamic' \
    "$STATIC_SOURCE" > "$IOS_STATIC"

jq --arg vote "$VOTE_URL" \
    '.vote_servers = [{"url": $vote, "label": "Local"}]' \
    "$ANDROID_DYNAMIC" > "$IOS_DYNAMIC"

printf '  \033[32m✓\033[0m %-40s\n' "iOS local voting config"
printf '    static:  %s\n' "$STATIC_URL"
printf '    vote:    %s\n' "$VOTE_URL"
printf '    pir:     %s\n' "$(jq -r '.pir_endpoints | map(.url) | join(", ")' "$IOS_DYNAMIC")"
printf '    Set this URL in the iOS voting config settings when using the local chain.\n'
